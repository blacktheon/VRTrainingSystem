# Normalize line endings for text files
* text=auto

# Unity YAML/text assets
*.cs text
*.meta text
*.unity text
*.prefab text
# NOTE: *.asset must NOT be forced to text — TerrainData, baked meshes, and
# other binary .asset files get corrupted by CRLF conversion on checkout.
# `* text=auto` above already normalizes the YAML .asset files safely.
*.mat text
*.anim text
*.controller text
*.shader text
*.json text
*.md text

# Git LFS
*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.aar filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.TGA filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
